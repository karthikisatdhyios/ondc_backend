# Copy to .env and fill in values. Never commit .env.

# --- Server ---
PORT=8787

# --- OpenAI (optional — chat/recipe features; ONDC works without it) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# --- Stripe (optional — checkout / card authorization) ---
STRIPE_SECRET_KEY=
VITE_STRIPE_PUBLISHABLE_KEY=
STRIPE_CURRENCY=inr
STRIPE_COUNTRY=IN

# --- ONDC / Beckn (Buyer App) ---
BECKN_ENABLED=false
BAP_ID=bap.dhiyos.local
BAP_URI=http://localhost:8787
BECKN_UNIQUE_KEY_ID=dhiyos-bap-key-1

ONDC_REGISTRY_URL=https://preprod.registry.ondc.org/ondc
ONDC_GATEWAY_URL=https://preprod.gateway.ondc.org
ONDC_DOMAIN=ONDC:RET10
ONDC_CORE_VERSION=1.2.5
ONDC_COUNTRY=IND
ONDC_CITY=std:080
ONDC_ENV=preprod

# ONDC's encryption public key for your environment (from ONDC portal/docs).
ONDC_ENCRYPTION_PUBLIC_KEY=

# Optional: override search delivery location (defaults map from ONDC_CITY).
# ONDC_SEARCH_GPS=12.971600,77.594600
# ONDC_SEARCH_PINCODE=560001
# ONDC_FINDER_FEE_TYPE=percent
# ONDC_FINDER_FEE_AMOUNT=3

BECKN_SEARCH_TIMEOUT_MS=15000
BECKN_ACTION_TIMEOUT_MS=6000
BECKN_SKIP_INBOUND_VERIFY=false

# Alternative to server/beckn-keys.json — paste full JSON on one line for cloud deploys.
# BECKN_KEYS_JSON=

# --- Local dev mock seller (only used when BECKN_ENABLED=false) ---
MOCK_BPP_URL=http://localhost:8787/mock-bpp
MOCK_BPP_ID=mock-bpp.dhiyos.local
